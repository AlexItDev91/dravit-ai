    {
      "id": "guide",
      "name": "dravit_guide",
      "arguments": {
        "section": "overview"
      },
      "requires": "Authenticated connection; no selected project required."
    },
    {
      "id": "guide-protocol",
      "name": "dravit_guide",
      "arguments": {
        "section": "protocol"
